45\u0646 150 \u0627\u0644\u0649 300 \u0648\u0631\u0642\u0629 )\r\n. \u0627\u0644\u0643\u0628\u064a\u0631 ( \u0645\u0646 300 \u0627\u0644\u0649 400 \u0648\u0631\u0642\u0629 ).\r\n. \u0645\u062f\u0629 \u0627\u0644\u062a\u0646\u0641\u064a\u0630 : 3-5 \u0627\u064a\u0627\u0645 \u0648\u062a\u0632\u064a\u062f \u0627\u0644\u0645\u062f\u0629 \u0639\u0646 \u0637\u0644\u0628 \u0627\u0644\u0634\u062d\u0646.","availability":"IN_STOCK","sale_price":65,"on_sale":false}],"content_type":"product","currency":"SAR","value":65,"event_trigger_source":"WooCommerce"},"page":{"url":"http:\/\/www.ibn-sinaa.com\/product\/school-records-islamic-education\/"}}]}
